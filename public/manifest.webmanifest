{
  "name": "StudyHub: Group Circle System",
  "short_name": "StudyHub",
  "description": "Study together in small circles: chat, calls, shared notes, schedule, tasks and progress.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#081C15",
  "theme_color": "#081C15",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Messages", "url": "/messages", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My Groups", "url": "/groups", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "/tasks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
