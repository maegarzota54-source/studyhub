+<?php
+namespace App\Support;
+
+use App\Models\{StudyGroup, User};
+use Illuminate\Support\Collection;
+
+/**
+ * Automatic group matching. Scores every open circle against the student's profile
+ * (subjects 40, schedule 25, skill level 15, study goal 10, mode 10 = 100) and returns the best ones.
+ */
+class GroupMatcher
+{
+    public const MIN_SCORE = 25;
+
+    private static function words(?string $text): array {
+        return collect(preg_split('/[^\p{L}\p{N}]+/u', mb_strtolower((string) $text)))
+            ->filter(fn ($w) => mb_strlen($w) >= 3)->unique()->values()->all();
+    }
+
+    /** @return array{score:int, reasons:string[]} */
+    public static function score(User $u, StudyGroup $g): array {
+        $score = 0; $reasons = [];
+        $prefs = $u->study_preferences ?? [];
+
+        // Subjects (40): any of my subjects appears in the circle's topic or title.
+        $mine = collect($u->subjects ?? [])->map(fn ($s) => mb_strtolower(trim($s)))->filter();
+        $hay = mb_strtolower($g->topic.' '.$g->title);
+        $hit = $mine->filter(fn ($s) => $s !== '' && str_contains($hay, $s));
+        if ($hit->isNotEmpty()) { $score += 40; $reasons[] = 'Subject: '.$hit->first(); }
+
+        // Schedule (25): shared meeting days (15) + same time of day (10).
+        $days = $u->availability['days'] ?? [];
+        $shared = array_intersect($days, $g->meeting_days ?? []);
+        if ($shared) { $score += 15; $reasons[] = 'Free on '.implode(', ', $shared); }
+        $time = $u->availability['time'] ?? null;
+        if ($time && $time === $g->meeting_time) { $score += 10; $reasons[] = ucfirst($time).' sessions'; }
+
+        // Skill level (15): same = 15, one step apart = 7.
+        $order = ['beginner' => 0, 'intermediate' => 1, 'advanced' => 2];
+        $a = $order[$prefs['skill_level'] ?? ''] ?? null; $b = $order[$g->skill_level] ?? null;
+        if ($a !== null && $b !== null) {
+            if ($a === $b) { $score += 15; $reasons[] = 'Same skill level'; }
+            elseif (abs($a - $b) === 1) { $score += 7; }
+        }
+
+        // Study goal (10): goal words overlap with topic/description.
+        $goal = self::words($prefs['goal'] ?? '');
+        if ($goal && array_intersect($goal, self::words($g->topic.' '.$g->title.' '.$g->description))) {
+            $score += 10; $reasons[] = 'Matches your goal';
+        }
+
+        // Mode (10): online / in-person preference.
+        if (($prefs['mode'] ?? null) && $prefs['mode'] === $g->mode) { $score += 10; $reasons[] = ucfirst($g->mode); }
+
+        return ['score' => $score, 'reasons' => $reasons];
+    }
+
+    /** Open circles the student has not joined, best match first. */
+    public static function suggest(User $u, int $limit = 6): Collection {
+        return StudyGroup::query()->withCount('members')->withAvg('ratings', 'stars')
+            ->whereDoesntHave('members', fn ($q) => $q->whereKey($u->id))
+            ->get()
+            ->filter(fn ($g) => $g->members_count < $g->max_members)
+            ->map(function ($g) use ($u) {
+                $m = self::score($u, $g);
+                $g->setAttribute('match_score', $m['score']);
+                $g->setAttribute('match_reasons', $m['reasons']);
+                return $g;
+            })
+            ->filter(fn ($g) => $g->match_score >= self::MIN_SCORE)
+            ->sortByDesc('match_score')->take($limit)->values();
+    }
+
+    /** Study partners: students who share subjects / availability with me (never suspended or admins). */
+    public static function partners(User $u, int $limit = 6): Collection {
+        $mine = collect($u->subjects ?? [])->map(fn ($s) => mb_strtolower($s));
+        return User::where('id', '!=', $u->id)->where('role', 'student')->where('is_suspended', false)->get()
+            ->map(function ($p) use ($u, $mine) {
+                $common = collect($p->subjects ?? [])->filter(fn ($s) => $mine->contains(mb_strtolower($s)))->values();
+                $days = array_intersect($u->availability['days'] ?? [], $p->availability['days'] ?? []);
+                $score = ($common->isNotEmpty() ? 60 : 0) + ($days ? 25 : 0)
+                    + ((($u->study_preferences['skill_level'] ?? 'x') === ($p->study_preferences['skill_level'] ?? 'y')) ? 15 : 0);
+                return ['id' => $p->id, 'name' => $p->name, 'avatar_url' => $p->avatar_url, 'bio' => $p->bio,
+                    'score' => $score, 'common_subjects' => $common->all()];
+            })
+            ->filter(fn ($p) => $p['score'] >= 60)->sortByDesc('score')->take($limit)->values();
+    }
+}
